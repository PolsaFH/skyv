{
  "name": "skyv",
  "productName": "Skyv",
  "version": "0.2.1",
  "description": "Gi ut endringer på nettsider via FTP, med angre.",
  "main": "out/main/index.js",
  "private": true,
  "author": "Filip Hjelmeland",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && vite build -c vite.bridge.config.mts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --mac --arm64 --x64",
    "build:bridge": "vite build -c vite.bridge.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "basic-ftp": "^6.2.6",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "chokidar": "^6.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ftp-srv": "^4.6.3",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "dtrace-provider": false,
    "electron-winstaller": false,
    "ssh2": false
  },
  "build": {
    "appId": "no.skyv.app",
    "productName": "Skyv",
    "copyright": "Copyright © 2026 Filip Hjelmeland",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/icon.png",
      "!resources/bin/**"
    ],
    "asarUnpack": [
      "out/main/chunks/**",
      "out/bridge/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      }
    },
    "dmg": {
      "title": "Skyv ${version}",
      "artifactName": "Skyv-${version}-${arch}.dmg"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "afterSign": "scripts/adhocSign.cjs"
  }
}
